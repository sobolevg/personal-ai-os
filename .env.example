# Link Capture service
TELEGRAM_BOT_TOKEN=
NOTION_TOKEN=
NOTION_DATABASE_ID=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=

# Optional PLAUD Developer API transcription provider
PLAUD_CLIENT_ID=
PLAUD_API_KEY=
PLAUD_BASE_URL=https://platform-us.plaud.ai

# Optional PLAUD Web fallback on the VPS (persistent profile, no credentials)
PLAUD_WEB_BROWSER_PYTHON=/opt/vfs-slot-watcher/.venv/bin/python
PLAUD_WEB_PROFILE_DIR=/root/.hermes/browser-profiles/plaud-web
PLAUD_WEB_TIMEOUT_SECONDS=900
PLAUD_WEB_HEADLESS=1
